# - VIP群：更“精” => detail，每条一张卡，DO_NOW，冷却 120h，数量更少
FEISHU_GROUP_CONFIG_JSON='{
  "group_main": {
    "name": "北美POD趋势指南（通用群）",
    "tier": "main",
    "mode": "digest",
    "max_push": 5,
    "cooldown_hours": 72,
    "levels": ["DO_NOW", "WATCH"],
    "only_ready": true
  },
  "group_vip": {
    "name": "北美POD趋势VIP群",
    "tier": "vip",
    "mode": "detail",
    "max_push": 3,
    "cooldown_hours": 120,
    "levels": ["DO_NOW"],
    "only_ready": true
  }
}'

